# ─────────────────────────────────────────────────────────────────────────────
# the swing — environment template. Copy to .env and fill. NEVER commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── Mantle networks ──────────────────────────────────────────────────────────
# Testnet (Sepolia) is the build/demo target.
MANTLE_SEPOLIA_CHAIN_ID=5003
MANTLE_SEPOLIA_RPC_URL=https://rpc.sepolia.mantle.xyz
MANTLE_SEPOLIA_EXPLORER=https://explorer.sepolia.mantle.xyz
MANTLE_SEPOLIA_FAUCET=https://faucet.sepolia.mantle.xyz

MANTLE_MAINNET_CHAIN_ID=5000
MANTLE_MAINNET_RPC_URL=https://rpc.mantle.xyz
MANTLE_MAINNET_EXPLORER=https://explorer.mantle.xyz

# ── Contract verification (Mantlescan, Etherscan-powered) ────────────────────
# Free key from mantlescan.xyz. Mantlescan is on the Etherscan API V2 multichain
# endpoint now, so foundry verifies via https://api.etherscan.io/v2/api?chainid=5003.
# See contracts/README or `forge verify-contract ... --verifier-url <that>`.
MANTLESCAN_API_KEY=

# ── Verified on-chain trade record (engine) ──────────────────────────────────
# The engine reads this address's real DEX swaps on Mantle MAINNET (Merchant Moe /
# Agni) via the Etherscan V2 account API (reuses MANTLESCAN_API_KEY) and reconstructs
# realized PnL. Default is a real trader DISCOVERED + vetted on-chain (84% win, +$768
# over 25 days, engine score 710). Find your own — e.g. a RealClaw agent — with:
#   pnpm --filter @swing/engine scan --router 0x<dex-router> --limit 40
# (ranks candidates by engine reputation score; drop the winner in below).
MANTLE_TRADER_ADDRESS=0x49931fec472026077719c9a49a0108a578a70814
# Provenance shown in the UI (be honest about what the wallet is). Override both when you
# point MANTLE_TRADER_ADDRESS at a specific RealClaw / competition agent.
MANTLE_TRADER_LABEL=Live Mantle DEX trader
MANTLE_TRADER_NOTE=

# ── ERC-8004 canonical singletons (per-chain vanity addresses) ───────────────
# VERIFY on-chain before trusting (PRD caveat: addresses snapshotted early 2026).
ERC8004_IDENTITY_SEPOLIA=0x8004A818BFB912233c491871b3d84c89A494BD9e
ERC8004_REPUTATION_SEPOLIA=0x8004B663056A597Dffe9eCcC1965A193B7388713
ERC8004_IDENTITY_MAINNET=0x8004A169FB4a3325136EB29fA0ceB6D2e539a432
ERC8004_REPUTATION_MAINNET=0x8004BAa17C55a88189AE136b182e5fdA19dE9b63

# ── the swing deployed contracts (filled by deploy script) ───────────────────
SWING_REPUTATION_ORACLE=
SWING_CREDIT_VAULT=
SWING_CREDIT_MANAGER=
SWING_SPENDING_GUARD_VALIDATOR=
SWING_SPENDING_GUARD_HOOK=
SWING_GUARDED_ACCOUNT_FACTORY=

# ── Vault asset (pull + verify real Mantle token addresses before hardcoding) ─
# Candidates: USDC, USDY (Ondo T-bill), mUSD, USDe, mETH. Engine uses a mock
# 6-decimal USDC on Sepolia until a real one is pinned.
VAULT_ASSET_ADDRESS=
VAULT_ASSET_DECIMALS=6

# ── Signers (use throwaway testnet keys only) ────────────────────────────────
# Deployer of the swing contracts.
DEPLOYER_PRIVATE_KEY=
# Reputation Engine signer — a member of the ReputationOracle signer committee.
ORACLE_SIGNER_PRIVATE_KEY=
# ReputationOracle signer COMMITTEE (k-of-n; no single key can fabricate a score).
#  - At DEPLOY: defaults to a 1-of-1 (ORACLE_SIGNER_ADDRESS / deployer). For a 2-of-3, set the
#    extra signer ADDRESSES + threshold below.
ORACLE_SIGNER_ADDRESS=
ORACLE_SIGNER_2=
ORACLE_SIGNER_3=
ORACLE_THRESHOLD=1
#  - At RUNTIME: the engine must hold `threshold` of the committee's PRIVATE KEYS to assemble a
#    quorum. Comma-separated; falls back to ORACLE_SIGNER_PRIVATE_KEY (a 1-of-1) if unset.
ORACLE_SIGNER_KEYS=

# ── Account abstraction (Pimlico bundler + paymaster, EntryPoint v0.7) ────────
# Powers the live ERC-7579 demo (`pnpm --filter @swing/engine aa-demo`): a real Kernel v3.1 smart
# account on Mantle Sepolia with the SpendingGuard modules installed, gas SPONSORED by Pimlico.
# Get a free key at dashboard.pimlico.io — its v2 endpoint serves both bundler + paymaster, so the
# engine derives https://api.pimlico.io/v2/5003/rpc?apikey=<key> automatically. Override only if you
# run your own bundler/paymaster.
PIMLICO_API_KEY=
BUNDLER_RPC_URL=
PAYMASTER_RPC_URL=
# Owner of the Kernel smart account (signs UserOps; needs no funds since gas is sponsored). Falls
# back to the deployer / oracle-signer key so the demo runs out of the box.
AA_OWNER_PRIVATE_KEY=
# Scoped agent session key authorized by the SpendingGuardValidator — a throwaway the agent holds.
# Set a DEDICATED key (different from the owner) to show the "stolen operator key can't sign" beat.
AGENT_SESSION_PRIVATE_KEY=
# Salt index for the Kernel smart account (changes its counterfactual address). The demo funds +
# installs modules on first use; bump this to start from a clean account if you reconfigured policy.
AA_ACCOUNT_INDEX=0

# ── AI reasoning / explanations (Z.ai GLM — sponsor + judge) ─────────────────
# Get your own key at z.ai (each teammate uses theirs). Leave blank to use the
# deterministic template explainer; set it and /health reports explainer: glm.
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
# glm-4.5-flash is the FREE tier and works with no balance. glm-4.6 is the paid flagship.
ZAI_MODEL=glm-4.5-flash
# Fallback provider behind the model abstraction (live-demo reliability).
ANTHROPIC_API_KEY=
FALLBACK_MODEL=claude-sonnet-4-6

# ── Byreal Skills CLI / RealClaw PnL source ──────────────────────────────────
# DATA_SOURCE=byreal-cli | realclaw | simulated   (simulated is the safe default)
DATA_SOURCE=simulated
BYREAL_CLI_BIN=byreal
REALCLAW_API_KEY=

# ── Sybil resistance (Gitcoin / Human Passport) ──────────────────────────────
PASSPORT_API_KEY=
PASSPORT_SCORER_ID=
PASSPORT_MIN_SCORE=15

# ── Engine service ───────────────────────────────────────────────────────────
ENGINE_PORT=8787
ENGINE_PUBLIC_URL=http://localhost:8787
